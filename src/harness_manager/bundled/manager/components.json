    {
      "id": "agent-rules",
      "identity": {"name": "Agent 通用规则", "kind": "rules", "source": {"relative": "../rules/agent-rules"}},
      "install": {
        "owner": "harness-manager", "replaceable": true,
        "targets": [{"root": "host", "source": "rules", "path": "rules/agent-rules"}]
      },
      "runtime": {},
      "health": {"command": ["{python}", "-c", "import json; from pathlib import Path; rules=json.loads(Path('catalog.json').read_text(encoding='utf-8'))['rules']; [Path(rule['entry']).read_text(encoding='utf-8') for rule in rules]"]},
      "update": {"strategy": "bundled", "policy": "host-release", "owner": "harness-manager"},
      "capabilities": ["modular-instructions", "host-rule-projection"],
      "dependencies": {"required": [], "optional": []}
    },
    {
      "id": "codegraph",
      "identity": {
        "name": "CodeGraph",
        "kind": "code-provider",
        "source": {
          "relative": "../sources/codegraph",
          "env": "CODEGRAPH_ROOT"
        }
      },
      "install": {
        "owner": "codegraph",
        "replaceable": true,
        "git": {
          "url": "https://github.com/colbymchenry/codegraph.git"
        },
        "commands": [
          [
            "npm",
            "ci"
          ],
          [
            "npm",
            "run",
            "build"
          ]
        ]
      },
      "runtime": {
        "entry": [
          "node",
          "dist/bin/codegraph.js"
        ],
        "version": [
          "node",
          "dist/bin/codegraph.js",
          "version"
        ]
      },
      "health": {
        "command": [
          "node",
          "dist/bin/codegraph.js",
          "version"
        ]
      },
      "update": {
        "strategy": "source-aware",
        "policy": "automatic-capable",
        "repository": ".",
        "remote": "origin",
        "branch": "main",
        "ignored_paths": [
          ".codegraph",
          "cleanread"
        ],
        "check": [
          "node",
          "dist/bin/codegraph.js",
          "upgrade",
          "--check"
        ],
        "apply": {
          "kind": "source-aware",
          "fallback": [
            "node",
            "dist/bin/codegraph.js",
            "upgrade"
          ]
        },
        "activation": "next-session",
        "timeout": 90,
        "health_timeout": 90
      },
      "capabilities": [
        "symbol-search",
        "source-extract",
        "call-graph",
        "impact-analysis",
        "mcp"
      ],
      "dependencies": {
        "required": [],
        "optional": []
      }
    },
